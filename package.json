{
  "name": "minimi-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack project setup with Express backend and concurrently runner",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"backend,frontend\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:be": "npm run dev:backend",
    "test": "npm run test --prefix backend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm install && npm run install:backend",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:push": "npm run prisma:push --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
